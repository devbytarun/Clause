# ---- Required -----------------------------------------------------------
# Postgres connection string (Neon pooled endpoint recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- App ----------------------------------------------------------------
APP_URL=http://localhost:3000

# ---- Google Gemini (required for AI features) ---------------------------
# Restricted API key bound to the Generative Language API only.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Thinking budgets (tokens). Analysis defaults to 2048; chat to 0 (fast).
GEMINI_ANALYSIS_THINKING_BUDGET=
GEMINI_CHAT_THINKING_BUDGET=

# ---- Cron ---------------------------------------------------------------
# Shared secret for /api/cron/cleanup (leave empty to disable the endpoint).
CRON_SECRET=

# ---- Supabase (storage + auth; same project) ----------------------------
# Service key is server-only — never expose it to the browser.
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=docs-prod

# ---- Limits / tuning ----------------------------------------------------
SIGNED_URL_TTL_SECONDS=900
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_FILE_URLS_PER_HOUR=60
RATE_LIMIT_RETRY_PER_HOUR=3

# ---- Auth (Supabase Auth — free tier) -----------------------------------
# Project URL + anon key from supabase.com → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 after enabling the Google provider in Supabase dashboard.
NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN=0

# ---- Monitoring ---------------------------------------------------------
SENTRY_DSN=

# ---- Testing (CI / local integration tests only) ------------------------
TEST_DATABASE_URL=
