# ---- Required -----------------------------------------------------------
# Postgres connection string (Neon pooled endpoint recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Used to sign local PDF URLs — generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- App ----------------------------------------------------------------
APP_URL=http://localhost:3000

# ---- Google Gemini (required for AI features) ---------------------------
# Restricted API key bound to the Generative Language API only.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Thinking budgets (tokens). Analysis defaults to 2048; chat to 0 (fast).
GEMINI_ANALYSIS_THINKING_BUDGET=
GEMINI_CHAT_THINKING_BUDGET=
# App-level daily cap across ALL Gemini calls (analysis + chat combined).
# Set near your model's free-tier RPD shown in AI Studio (default 400).
GEMINI_DAILY_REQUEST_LIMIT=400

# ---- Cron ---------------------------------------------------------------
# Shared secret for /api/cron/cleanup (leave empty to disable the endpoint).
CRON_SECRET=

# ---- Local storage -------------------------------------------------------
# PDFs are stored under .storage in the project directory.
STORAGE_DRIVER=local
# Active documents are automatically deleted after this many days.
DOCUMENT_RETENTION_DAYS=7

# ---- Limits / tuning ----------------------------------------------------
SIGNED_URL_TTL_SECONDS=900
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_FILE_URLS_PER_HOUR=60
RATE_LIMIT_RETRY_PER_HOUR=3

# ---- Monitoring ---------------------------------------------------------
SENTRY_DSN=

# ---- Testing (CI / local integration tests only) ------------------------
TEST_DATABASE_URL=
