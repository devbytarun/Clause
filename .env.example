# ---- Required -----------------------------------------------------------
# Postgres connection string (Neon pooled endpoint recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- App ----------------------------------------------------------------
APP_URL=http://localhost:3000

# ---- Google Gemini (required from Phase 2 onward) -----------------------
# Restricted API key bound to the Generative Language API only.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ---- Supabase Storage (required from Phase 3 onward) --------------------
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=docs-prod

# ---- Limits / tuning ----------------------------------------------------
SIGNED_URL_TTL_SECONDS=900
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_FILE_URLS_PER_HOUR=60
RATE_LIMIT_RETRY_PER_HOUR=3

# ---- Auth providers (at least one required for login) -------------------
# Google OAuth: console.cloud.google.com → Credentials → OAuth client ID
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links (SMTP). EMAIL_FROM must be a valid address.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ---- Monitoring ---------------------------------------------------------
SENTRY_DSN=

# ---- Testing (CI / local integration tests only) ------------------------
TEST_DATABASE_URL=
